<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Shopping Hub</title>
  <link rel="stylesheet" href="partner.css">
  <!-- Link Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <header>
    <div class="top-bar">
      <div class="logo-wrap">
        <img src="images/logo.png" alt="Logo" class="logo">
        <h1>PARTNER TRIPMIND</h1>
      </div>
      <div class="top-icons">
        <button><i class="fa-solid fa-circle-question"></i></button>
        <button><i class="fa-solid fa-gear"></i></button>
      </div>
    </div>
    <nav class="menu">
      <a href="#"><i class="fa-solid fa-house"></i> Trang chủ</a>
      <a href="#"><i class="fa-solid fa-box"></i> Sản phẩm</a>
      <a href="#"><i class="fa-solid fa-wallet"></i> Tài chính</a>
      <a href="#"><i class="fa-solid fa-comments"></i> Chat box</a>
      <a href="#"><i class="fa-solid fa-bullhorn"></i> Marketing</a>
      <a href="#"><i class="fa-solid fa-lightbulb"></i> Xem gợi ý</a>
    </nav>
  </header>

  <main>
    <aside class="sidebar">
      <ul>
        <li><i class="fa-solid fa-envelope"></i> Chưa đọc</li>
        <li><i class="fa-solid fa-exclamation"></i> Quan trọng</li>
        <li><i class="fa-solid fa-star"></i> Theo dõi</li>
        <li><i class="fa-solid fa-circle-exclamation"></i> Spam</li>
      </ul>
    </aside>

    <section class="content">
      <div class="cover">
        <button class="add-cover-btn">+ Thêm ảnh bìa tại đây</button>
      </div>
    </section>
  </main>
</body>
</html>
