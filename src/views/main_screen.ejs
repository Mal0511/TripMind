<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TRIPMIND</title>
    <link rel="stylesheet" href="style.css" />
  </head>

  <body>
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <div class="hero-content">
        <h1 id="hero-title">PASSION IN EACH PRODUCT</h1>
        <p id="hero-desc">
          Not only selling products - Must sell to customers FAITH
        </p>
        <button>VIEW PRODUCT</button>
      </div>

      <!-- Navbar -->
      <div class="navbar">
        <div class="logo">TRIPMIND</div>
        <ul>
          <li><a href="#">HOME</a></li>
          <li><a href="#">PLAN</a></li>
          <li><a href="#">PLACE&WEATHER</a></li>
          <li><a href="#">BOOKING</a></li>
          <% if (user && user.userrole === 'admin') { %>
          <li><a href="/user-list">USER</a></li>
          <li><a href="/partner-list">PARTNER</a></li>
          <% } %>
          <li><a href="#">SETTINGS</a></li>
        </ul>
        <button class="consultant-btn">CONTACT US</button>
        <% if (user) { %>
        <button class="logout-btn" onclick="logout()">LOGOUT</button>
        <% } %>
      </div>
    </section>

    <!-- Script slider -->
    <!--<script>
        if (!localStorage.getItem('isLoggedIn')) {
            window.location.href = 'login.ejs';
        }
     </script> -->
    <script src="\js\main_screen.js"></script>
  </body>
</html>
